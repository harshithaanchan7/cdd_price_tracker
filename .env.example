# Smart Price Tracker - Scraper Module Environment Configuration
# Copy this file to .env to configure local settings or optional API credentials.

# Slot 1: Open Prices (No credentials required - uses public ODbL REST API)
OPEN_PRICES_USER_AGENT=SmartPriceTracker/1.0 (CollegeProject; contact: student@example.edu)

# Slot 2: Controlled Demonstration Storefront
LOCAL_STORE_URL=http://127.0.0.1:8000

# Slot 3: Amazon Creators API (Optional - Credential-Gated)
# Gated behind active Amazon Associates account with 10 qualifying sales in trailing 30 days.
AMAZON_CREDENTIAL_ID=
AMAZON_CREDENTIAL_SECRET=
AMAZON_PARTNER_TAG=

# Slot 4: Flipkart Affiliate API (Optional - Credential-Gated)
# Gated behind approved legacy Flipkart affiliate account.
FLIPKART_AFFILIATE_ID=
FLIPKART_AFFILIATE_TOKEN=

