
# Smart Price Tracker - Root Environment Configuration

# Backend / MongoDB
MONGO_URI=mongodb://mongo:27017/price_tracker

# Redis / Celery
REDIS_URL=redis://redis:6379/0

# Frontend API
VITE_API_URL=http://localhost:8000

# Scraper - Open Prices
OPEN_PRICES_USER_AGENT=SmartPriceTracker/1.0 (CollegeProject; contact: student@example.edu)

# Scraper - Local Demo Store
LOCAL_STORE_URL=http://127.0.0.1:8000

# Optional Amazon API credentials
AMAZON_CREDENTIAL_ID=
AMAZON_CREDENTIAL_SECRET=
AMAZON_PARTNER_TAG=

# Optional Flipkart API credentials
FLIPKART_AFFILIATE_ID=
FLIPKART_AFFILIATE_TOKEN=

# Optional Telegram notifications
TELEGRAM_BOT_TOKEN=

# Optional email notifications
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
